{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kursbuch",
  "version": "0.1.0",
  "identifier": "de.nojo.kursbuch",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1436",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Kursbuch",
        "width": 1080,
        "height": 760,
        "minWidth": 760,
        "minHeight": 520,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#1c1c1e",
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "kursbuch"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German",
          "English"
        ]
      }
    }
  }
}
